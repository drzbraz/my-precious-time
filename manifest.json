{
  "manifest_version": 3,
  "name": "My Precious Time",
  "version": "0.3.3",
  "description": "A private, real-time meeting cost meter for Google Meet.",
  "key": "",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://www.googleapis.com/*",
    "https://precious-time-backend.drz-braz.workers.dev/*"
  ],
  "oauth2": {
    "client_id": "329680931594-vsheq7o55regtk3r4475s2pvk1gl43eh.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "icons": {
    "16": "public/icon16.png",
    "32": "public/icon32.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  },
  "action": {
    "default_title": "My Precious Time",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "public/icon16.png",
      "32": "public/icon32.png",
      "48": "public/icon48.png",
      "128": "public/icon128.png"
    }
  },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://meet.google.com/*"],
    "js": ["content.js"],
    "css": ["overlay.css"],
    "run_at": "document_idle"
  }]
}
