{
  "manifest_version": 3,
  "name": "Precious Time",
  "version": "0.1.0",
  "description": "A private, real-time meeting cost meter for Google Meet.",
  "key": "",
  "permissions": ["storage", "identity"],
  "host_permissions": ["https://meet.google.com/*", "https://www.googleapis.com/*"],
  "oauth2": {
    "client_id": "11649191724-bqbruorea2t2jq9gj13v0vu9p1u80l1m.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "icons": {
    "16": "public/icon16.png",
    "32": "public/icon32.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  },
  "action": {
    "default_title": "Precious Time",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "public/icon16.png",
      "32": "public/icon32.png",
      "48": "public/icon48.png",
      "128": "public/icon128.png"
    }
  },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://meet.google.com/*"],
    "js": ["content.js"],
    "css": ["overlay.css"],
    "run_at": "document_idle"
  }]
}
